<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RAVEN Dashboard - Error</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #0a0a0a;
      color: #e0e0e0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .error-container {
      background-color: #1a1a1a;
      border: 1px solid #333;
      border-left: 6px solid #8B0000;
      border-radius: 8px;
      padding: 3rem 2.5rem;
      max-width: 900px;
      width: 90%;
      text-align: center;
      box-shadow: 0 6px 18px rgba(0,0,0,0.6);
    }

    .error-code {
      font-size: 4rem;
      font-weight: 800;
      color: #8B0000;
      margin-bottom: 0.5rem;
    }

    .error-message {
      font-size: 1.25rem;
      color: #cfcfcf;
      margin-bottom: 1.25rem;
    }

    .back-link {
      display: inline-block;
      margin-top: 0.5rem;
      color: #8B0000;
      text-decoration: none;
      font-weight: 600;
      border: 1px solid transparent;
      padding: 0.5rem 0.75rem;
      border-radius: 6px;
      transition: all 0.18s ease;
      background: transparent;
    }

    .back-link:hover {
      color: #fff;
      background: #8B0000;
    }

    @media (max-width: 480px) {
      .error-code { font-size: 3rem; }
      .error-message { font-size: 1rem; }
      .error-container { padding: 2rem; }
    }
  </style>
</head>
<body>
  <main class="error-container">
    <div class="error-code"><%= statusCode || 'Error' %></div>
    <div class="error-message"><%= message || 'An unexpected error occurred.' %></div>
    <a class="back-link" href="/dashboard/servers">← Back to servers</a>
  </main>
</body>
</html>
