<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RAVEN Dashboard - Server Settings</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #0a0a0a;
      color: #e0e0e0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6;
    }

    header {
      background-color: #1a1a1a;
      border-bottom: 2px solid #8B0000;
      padding: 1.5rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .user-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 2px solid #8B0000;
      object-fit: cover;
    }

    .user-info h1 {
      font-size: 1.25rem;
      color: #ffffff;
    }

    .user-info p {
      font-size: 0.875rem;
      color: #b0b0b0;
    }

    .logout-btn {
      background-color: #8B0000;
      color: #ffffff;
      border: none;
      padding: 0.75rem 1.5rem;
      border-radius: 4px;
      cursor: pointer;
      font-size: 1rem;
      font-weight: 500;
      transition: background-color 0.3s ease;
      text-decoration: none;
      display: inline-block;
    }

    .logout-btn:hover {
      background-color: #a50000;
    }

    main {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 2rem;
      font-size: 0.95rem;
    }

    .breadcrumb a {
      color: #8B0000;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .breadcrumb a:hover {
      color: #a50000;
    }

    .breadcrumb span {
      color: #666;
    }

    .page-title {
      font-size: 2rem;
      color: #ffffff;
      margin-bottom: 2rem;
    }

    .success-banner {
      background-color: #1a3a1a;
      border: 1px solid #2d5a2d;
      border-left: 4px solid #27ae60;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 2rem;
      color: #27ae60;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .success-banner.hidden {
      display: none;
    }

    .settings-section {
      background-color: #1a1a1a;
      border: 1px solid #333;
      border-radius: 8px;
      padding: 2rem;
      margin-bottom: 2rem;
    }

    .settings-section h2 {
      font-size: 1.5rem;
      color: #ffffff;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .settings-section h2::before {
      content: '';
      display: inline-block;
      width: 4px;
      height: 1.5rem;
      background-color: #8B0000;
      border-radius: 2px;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #ffffff;
    }

    .form-group textarea {
      width: 100%;
      padding: 0.75rem;
      background-color: #0a0a0a;
      border: 1px solid #333;
      border-radius: 4px;
      color: #e0e0e0;
      font-family: 'Courier New', monospace;
      font-size: 0.95rem;
      resize: vertical;
      min-height: 120px;
      transition: border-color 0.3s ease;
    }

    .form-group textarea:focus {
      outline: none;
      border-color: #8B0000;
      box-shadow: 0 0 0 2px rgba(139, 0, 0, 0.1);
    }

    .form-group p {
      font-size: 0.875rem;
      color: #999;
      margin-top: 0.5rem;
    }

    .save-btn {
      background-color: #8B0000;
      color: #ffffff;
      border: none;
      padding: 0.75rem 2rem;
      border-radius: 4px;
      cursor: pointer;
      font-size: 1rem;
      font-weight: 500;
      transition: background-color 0.3s ease;
    }

    .save-btn:hover {
      background-color: #a50000;
    }

    .save-btn:active {
      transform: scale(0.98);
    }

    .coming-soon {
      background-color: #1a1a1a;
      border: 1px dashed #333;
      border-radius: 8px;
      padding: 2rem;
      text-align: center;
      color: #666;
    }

    .coming-soon h2 {
      color: #8B0000;
      margin-bottom: 0.5rem;
    }

    footer {
      text-align: center;
      padding: 2rem;
      border-top: 1px solid #333;
      color: #707070;
      font-size: 0.875rem;
      margin-top: 3rem;
    }
  </style>
</head>
<body>
  <header>
    <div class="header-left">
      <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="<%= user.username %>" class="user-avatar">
      <div class="user-info">
        <h1><%= user.username %></h1>
        <p><%= guildName %></p>
      </div>
    </div>
    <a href="/auth/logout" class="logout-btn">Logout</a>
  </header>

  <main>
    <div class="breadcrumb">
      <a href="/dashboard/servers">← Back to servers</a>
      <span>/</span>
      <span><%= guildName %></span>
    </div>

    <h1 class="page-title">Server Settings</h1>

    <% if (saved === 'welcome') { %>
      <div class="success-banner">
        <span>✅</span>
        <span>Welcome message saved!</span>
      </div>
    <% } %>

    <!-- Welcome Message Section -->
    <div class="settings-section">
      <h2>Welcome Message</h2>
      <form method="POST" action="/dashboard/<%= guildId %>/welcome">
        <div class="form-group">
          <label for="welcomeMessage">Message Content</label>
          <textarea
            id="welcomeMessage"
            name="welcomeMessage"
            placeholder="Enter the welcome message that will be sent to new members..."
          ><%= settings.welcome_message || '' %></textarea>
          <p>This message will be sent to new members when they join your server (if a welcome channel is configured).</p>
        </div>
        <button type="submit" class="save-btn">Save Welcome Message</button>
      </form>
    </div>

    <!-- Auto-role Section (Coming Soon) -->
    <div class="coming-soon">
      <h2>Auto-role — Coming soon</h2>
      <p>Configure automatic role assignment for new members</p>
    </div>
  </main>

  <footer>
    <p>&copy; 2026 RAVEN Dashboard. All rights reserved.</p>
  </footer>
</body>
</html>
